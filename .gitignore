# ============================================================
# 环境变量 / 密钥（绝对不能上传：零密钥泄漏目标）
# fastapi-app/.env 含 DB 密码 / DashScope Key / JWT 密钥
# ============================================================
.env
**/.env
**/.env.local
**/.env.*.local

# 豁免：示例模板（公开，必须入库）
!.env.example
!**/.env.example

# vue 环境配置：含部署地址，按本地文件管理不入库
vue/.env.development
vue/.env.production

# ============================================================
# Python
# ============================================================
# 字节码 / 缓存
__pycache__/
*.py[cod]
*$py.class
*.so

# 虚拟环境（项目使用 fastapi-app/.venv）
.venv/
venv/

# 测试 / 类型 / Lint 缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover

# 打包产物
build/
*.egg-info/

# ============================================================
# Node / 前端
# ============================================================
node_modules/
.npm/
.pnpm-store/

# Vite 构建产物（dist/ 已覆盖任意层级，含 vue/dist）
dist/

# ============================================================
# 上传文件（fastapi-app/files/）
# goods/、avatar/ 的种子图随仓库分发——新克隆即有商品图与演示头像；
# review/ 是用户运行时上传，各环境各自生成，不入库
# ============================================================
fastapi-app/files/review/

# ============================================================
# 数据库 / 向量库
# cake_store.sql 是部署必需品（migrate.sh 基础 schema 来源），必须入库
# ============================================================
*.db
*.sqlite
*.sqlite3
chroma_db/

# ============================================================
# 日志（一键启动脚本写入 logs/startup_*/）
# ============================================================
*.log
logs/

# ============================================================
# 临时 / 备份 / 进程文件
# ============================================================
*.tmp
*.temp
*.bak
*.orig
*.pid

# ============================================================
# IDE / 编辑器
# ============================================================
.idea/
.vscode/
*.swp
*.swo
*~

# ============================================================
# 操作系统
# ============================================================
# macOS
.DS_Store
.DS_Store?
._*
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes
# Windows
ehthumbs.db
Thumbs.db
Desktop.ini

# ============================================================
# 其他工具
# ============================================================
# Claude Code 本地配置
.claude/
# Jupyter Notebook 检查点
.ipynb_checkpoints/

# ============================================================
# 本地归档文档（个人工作产物，不入库）
# 注意：docs/ 下其余文档（architecture/code-review/roadmap）入库，
# README 与 db/README.md 会链接到它们，绝不可加进本段
# ============================================================
/docs/archive/
/docs/code-review.md
/docs/roadmap.md
