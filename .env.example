# 复制为 .env 并填入真实值（.env 已被 .gitignore 排除，不会提交）

# ---- MySQL ----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cake_store
DB_USER=root
DB_PASSWORD=your_db_password_here

# ---- DashScope（通义千问）----
DASHSCOPE_API_KEY=your_dashscope_api_key_here
LLM_MODEL=qwen-turbo
EMBEDDING_MODEL=text-embedding-v2
LLM_MAX_HISTORY=20
RAG_TOP_K=3

# ---- JWT（建议使用 openssl rand -hex 32 生成 64 字符随机串）----
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24
