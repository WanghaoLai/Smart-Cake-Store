# 复制为 fastapi-app/.env 并填入真实值（.env 已被 .gitignore 排除，不会提交）

# ---- 运行环境 / 前端跨域 ----
APP_ENV=development
# 生产环境设为真实前端域名，多个来源使用英文逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- MySQL ----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cake_store
DB_USER=root
DB_PASSWORD=your_db_password_here

# ---- DashScope（通义千问）----
DASHSCOPE_API_KEY=your_dashscope_api_key_here
LLM_MODEL=qwen-turbo
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
EMBEDDING_MODEL=text-embedding-v2
LLM_MAX_HISTORY=20
AGENT_MAX_MODEL_CALLS=4
AGENT_MAX_TOOL_CALLS=3
RAG_TOP_K=3
# 可选：切换 Agent 行为配置（默认使用 fastapi-app/agents/config/customer_service.json）
# AGENT_CONFIG_PATH=/absolute/path/to/customer_service.json
# 可选：启用 LangSmith 可观测性
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your_langsmith_api_key

# ---- JWT（建议使用 openssl rand -hex 32 生成 64 字符随机串）----
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24
