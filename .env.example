# 环境变量配置模板
# 复制此文件为 .env 并填入你的实际 API 密钥

# Tavily
TAVILY_API_KEY=your_tavily_api_key_here

# DeepSeek
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 小米 MIMO
XIAOMI_MIMO_MODEL=mimo-v2.5-pro
XIAOMI_MIMO_API_KEY=your_xiaomi_mimo_api_key_here
XIAOMI_MIMO_BASE_URL=https://api.xiaomimimo.com/v1

# SerpAPI
SERPAPI_API_KEY=your_serpapi_api_key_here

# Qdrant
QDRANT_URL=your_qdrant_url_here
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=hello_agents_vectors
QDRANT_VECTOR_SIZE=384
QDRANT_DISTANCE=cosine
QDRANT_TIMEOUT=30

# Neo4j
NEO4J_URI=your_neo4j_uri_here
NEO4J_USERNAME=your_neo4j_username_here
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=your_db_name
AURA_INSTANCEID=your_instance_id
AURA_INSTANCENAME=Instance01
NEO4J_MAX_CONNECTION_LIFETIME=3600
NEO4J_MAX_CONNECTION_POOL_SIZE=50
NEO4J_CONNECTION_TIMEOUT=60

# Embed Model
EMBED_MODEL_TYPE=dashscope
EMBED_MODEL_NAME=text-embedding-v2
EMBED_API_KEY=your_embed_api_key_here
EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1