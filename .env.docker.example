# Copy to .env.docker, replace every CHANGE_ME value, then always pass it with:
# docker compose --env-file .env.docker <command>

APP_ENV=production
APP_TIMEZONE=Asia/Shanghai
WEB_PORT=8080
API_PORT=9090
IMAGE_TAG=local
CORS_ORIGINS=http://localhost:8080

DB_NAME=cake_store
DB_USER=cake_app
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_DIFFERENT_ROOT_PASSWORD

# Optional: leave empty to keep non-AI shopping features available with graceful degradation.
DASHSCOPE_API_KEY=
LLM_MODEL=qwen-turbo
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_TEMPERATURE=0.2
EMBEDDING_MODEL=text-embedding-v2
LLM_MAX_HISTORY=20
RAG_TOP_K=3
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
AGENT_MAX_MODEL_CALLS=4
AGENT_MAX_TOOL_CALLS=3

CHAT_RATE_LIMIT=20
CHAT_RATE_WINDOW_SECONDS=60
GOODS_QA_RATE_LIMIT=10
GOODS_QA_RATE_WINDOW_SECONDS=60
AUTH_RATE_WINDOW_SECONDS=300
LOGIN_RATE_LIMIT_PER_ACCOUNT=5
LOGIN_RATE_LIMIT_PER_IP=30
REGISTER_RATE_LIMIT_PER_IP=10
REVIEW_UPLOAD_RATE_LIMIT=20
REVIEW_UPLOAD_RATE_WINDOW_SECONDS=3600
REVIEW_UPLOAD_USER_QUOTA_BYTES=104857600
REVIEW_UPLOAD_GLOBAL_QUOTA_BYTES=1073741824

SEARCH_CANDIDATE_K=20
SEARCH_TOP_K=10
SEARCH_HEAT_WEIGHT=0.15
RECOMMEND_W_FAVORITE=3.0
RECOMMEND_W_PURCHASE=2.0
RECOMMEND_W_RATING=1.0
RECOMMEND_W_SALES=0.5

WALLET_RECHARGE_MODE=disabled
JWT_SECRET_KEY=CHANGE_ME_TO_RANDOM_SECRET_AT_LEAST_32_CHARS_LONG
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=2
