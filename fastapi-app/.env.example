# ============================================================
# FastAPI 应用环境变量模板
# ------------------------------------------------------------
# 部署步骤：
#   1. cp .env.example .env
#   2. 按下方注释填入真实值（生产环境务必替换所有占位符）
#   3. JWT_SECRET_KEY 强制要求 ≥32 字符，否则启动会失败
#      生成强随机密钥：  python -c "import secrets; print(secrets.token_urlsafe(48))"
#   4. .env 已在 .gitignore 中，不会提交；本文件 (.env.example) 是公开模板
# ============================================================

# ---- 运行环境 / 跨域 ----
# development: 允许任意 localhost:* 的 CORS（便于本地调试）
# production:  仅放行 CORS_ORIGINS 白名单
APP_ENV=development

# 前端访问地址，多个用逗号分隔。生产环境必须改成真实域名
# 示例：https://cake.example.com,https://www.cake.example.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- 数据库 (MySQL) ----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cake_store
DB_USER=root
# 生产环境必须替换为强口令，且与 MySQL 实例实际密码一致
DB_PASSWORD=CHANGE_ME_TO_REAL_DB_PASSWORD

# ---- 智能问答 / LLM (DashScope 通义千问) ----
# 控制台获取：https://dashscope.console.aliyun.com/apiKey
DASHSCOPE_API_KEY=CHANGE_ME_TO_YOUR_DASHSCOPE_KEY
LLM_MODEL=qwen-turbo
EMBEDDING_MODEL=text-embedding-v2
LLM_MAX_HISTORY=20
RAG_TOP_K=3

# ---- 认证防爆破（单进程默认值；多实例部署请使用 Redis 共享计数）----
AUTH_RATE_WINDOW_SECONDS=300
LOGIN_RATE_LIMIT_PER_ACCOUNT=5
LOGIN_RATE_LIMIT_PER_IP=30
REGISTER_RATE_LIMIT_PER_IP=10

# 评价图片：每用户每小时最多 20 个，单用户 100MB，本地评价目录 1GB
REVIEW_UPLOAD_RATE_LIMIT=20
REVIEW_UPLOAD_RATE_WINDOW_SECONDS=3600
REVIEW_UPLOAD_USER_QUOTA_BYTES=104857600
REVIEW_UPLOAD_GLOBAL_QUOTA_BYTES=1073741824

# ---- JWT 鉴权 ----
# 强制要求 ≥32 字符（生产环境），开发环境建议也使用强密钥
# 生成命令：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_TO_RANDOM_SECRET_AT_LEAST_32_CHARS_LONG
JWT_ALGORITHM=HS256
# token 过期小时数；2 小时适合公网部署，内网可放宽
JWT_EXPIRE_HOURS=2
